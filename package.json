{
  "name": "anti-cheat-observatory",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "validate": "node scripts/validate.mjs",
    "sync": "node scripts/discovery.mjs",
    "digest": "node scripts/digest.mjs",
    "import": "node scripts/import-proposal.mjs",
    "build": "npm run validate && astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test",
    "format": "prettier --plugin=prettier-plugin-astro --write src scripts astro.config.mjs"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "^5.11.2",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  }
}
