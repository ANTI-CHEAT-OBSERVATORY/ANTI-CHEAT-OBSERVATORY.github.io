---
import Layout from "../../layouts/Layout.astro";
import ClaimEvidence from "../../components/ClaimEvidence.astro";
import { claims, sources, builds, mechanisms, corrections, validations } from "../../lib/knowledge";
import { records } from "../../lib/catalog";
import { withBase } from "../../lib/paths";
import type { Claim } from "../../lib/knowledge-types";
export function getStaticPaths() { return claims.map((claim) => ({ params: { id: claim.id }, props: { claim } })); }
const { claim } = Astro.props as { claim: Claim };
const related = claims.filter((other) => other.id !== claim.id && (other.contradicts.includes(claim.id) || other.supersedes.includes(claim.id) || claim.contradicts.includes(other.id) || claim.supersedes.includes(other.id)));
const revisions = corrections.filter((item) => item.claimIds.includes(claim.id));
const checks = validations.filter((item) => item.claimIds.includes(claim.id) || claim.validationIds.includes(item.id));
const citations = claim.citations.map((citation) => ({ citation, source: sources.find((source) => source.id === citation.sourceId) }));
const origins = Map.groupBy(citations, ({ source }) => source?.originId || "unknown origin");
---
<Layout title={`Claim · ${claim.id}`} description={claim.statement}>
  <div class="page-container evidence-detail" data-pagefind-body>
    <p><a href={withBase("/catalog")}>Catalog</a> / Claim <code>{claim.id}</code></p>
    <header class="page-header"><h1>{claim.statement}</h1><p class="mono">{claim.id}</p><button type="button" data-bookmark-id={claim.id} data-bookmark-type="claim" data-bookmark-title={claim.statement} data-bookmark-url={withBase(`/claims/${claim.id}`)} aria-pressed="false">Save claim</button></header>
    <ClaimEvidence claim={claim} />
    <section class="panel"><h2>Scope and review are separate</h2><dl><dt>Provenance</dt><dd>{claim.provenance}</dd><dt>Review activity</dt><dd>{claim.review} · {claim.reviewedAt}</dd><dt>Claim state</dt><dd>{claim.state}</dd><dt>Assertion type</dt><dd>{claim.kind}</dd><dt>Applicability</dt><dd>{claim.applicability}</dd><dt>Build scope</dt><dd>{claim.buildIds.length ? claim.buildIds.map((id) => <a href={withBase(`/builds/${id}`)}>{builds.find((build) => build.id === id)?.label ?? id}</a>) : "Unknown / no identified build. Do not apply this claim to a selected or current build."}</dd><dt>Systems</dt><dd>{claim.systemIds.length ? claim.systemIds.map((id) => <a href={withBase(`/records/${id}`)}>{records.find((record) => record.id === id)?.title ?? id}</a>) : "Unspecified"}</dd><dt>Mechanisms</dt><dd>{claim.mechanismIds.length ? claim.mechanismIds.map((id) => <a href={withBase(`/mechanisms/${id}`)}>{mechanisms.find((mechanism) => mechanism.id === id)?.title ?? id}</a>) : "Not linked"}</dd></dl>{claim.limitations.length > 0 && <><h3>Limits</h3><ul>{claim.limitations.map((limit) => <li>{limit}</li>)}</ul></>}</section>
    <section class="panel"><h2>Evidence by original source</h2><p>Multiple citations or mirrors with the same origin are grouped, not counted as independent confirmations.</p>{[...origins].map(([origin, entries]) => <div><h3>Origin <code>{origin}</code></h3><ul>{entries.map(({ citation, source }) => <li><a href={withBase(`/sources/${citation.sourceId}`)}>{source?.title ?? citation.sourceId}</a> · {citation.relation} · {citation.locator.kind}: <code>{citation.locator.value}</code>{citation.locator.addressSpace && <> · address space: {citation.locator.addressSpace}</>}{citation.locator.imageBase && <> · image base: <code>{citation.locator.imageBase}</code></>}{citation.locator.url && <> · <a href={citation.locator.url} rel="noopener noreferrer">Exact locator</a></>}<p>{citation.evidence}</p><small>{source?.revision.kind}: {source?.revision.value ?? "unversioned"} · {source?.access} · {source?.transport}</small></li>)}</ul></div>)}{citations.length === 0 && <p>No source citation recorded. This claim must not be treated as established evidence.</p>}</section>
    <section class="panel"><h2>Contradictions and supersession</h2>{related.length ? <ul>{related.map((item) => <li><a href={withBase(`/claims/${item.id}`)}>{item.statement}</a> · {item.state} · {claim.contradicts.includes(item.id) || item.contradicts.includes(claim.id) ? "contradiction" : "supersession"}</li>)}</ul> : <p>No linked opposing or superseding claim recorded; absence is not corroboration.</p>}</section>
    <section class="panel"><h2>Validation ledger</h2>{checks.length ? <ul>{checks.map((item) => <li><strong>{item.title}</strong> · {item.performedBy} / {item.authority} / {item.activity} / {item.status} · {item.executedAt ?? "execution date not supplied"}<p>{item.observed || "No observed result supplied."} Bounds: {item.bounds || "not documented"}</p>{item.buildId && <a href={withBase(`/builds/${item.buildId}`)}>Build {item.buildId}</a>}</li>)}</ul> : <p>No validation record; source-reported results are not independent reproduction.</p>}<a href={withBase("/workspace")}>Record a bounded validation proposal</a></section>
    <section class="panel"><h2>Corrections and events</h2>{revisions.length ? <ul>{revisions.map((item) => <li><time datetime={item.date}>{item.date}</time> · {item.kind} / {item.status}: {item.title}<p>{item.summary}</p><p>Before: {item.before} · After: {item.after}</p>{item.sourceIds.map((id) => <a href={withBase(`/sources/${id}`)}>Source {id}</a>)}</li>)}</ul> : <p>No linked correction recorded.</p>}</section>
  </div>
</Layout>
<style>.evidence-detail{padding-block:2rem 5rem}.evidence-detail .panel{margin:1rem 0;padding:1rem 1.25rem}.evidence-detail dl{display:grid;grid-template-columns:minmax(9rem,14rem) 1fr;gap:.6rem}.evidence-detail dd{margin:0;overflow-wrap:anywhere}.evidence-detail dd a,.evidence-detail li a{margin-right:.7rem}.evidence-detail li{margin:.7rem 0}.evidence-detail code{overflow-wrap:anywhere}@media(max-width:600px){.evidence-detail dl{grid-template-columns:1fr}.evidence-detail dt{font-weight:bold}}</style>
