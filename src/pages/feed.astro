---
import Layout from "../layouts/Layout.astro";
import { discovery, discoveryItems, discoverySources } from "../lib/discovery";
import { withBase } from "../lib/paths";

const sources = new Map(discoverySources.map((source) => [source.id, source]));
const sourceOptions = [...discoverySources].sort((a, b) => a.name.localeCompare(b.name));
const topics = [...new Set(discoveryItems.flatMap((item) => item.topics))].sort();
const systems = [...new Set(discoveryItems.flatMap((item) => item.systemIds))].sort();
const items = [...discoveryItems].sort((a, b) =>
  (b.published ?? b.firstSeen).localeCompare(a.published ?? a.firstSeen) || a.title.localeCompare(b.title),
);
const safeExternal = (value: string) => {
  try {
    const url = new URL(value);
    return url.protocol === "https:" || url.protocol === "http:" ? url.href : null;
  } catch {
    return null;
  }
};
const dateLabel = (value: string | null) => {
  if (!value || Number.isNaN(Date.parse(value))) return "Not recorded";
  const date = new Date(value);
  return /^\d{4}-\d{2}-\d{2}$/.test(value)
    ? date.toISOString().slice(0, 10)
    : `${date.toISOString().slice(0, 16).replace("T", " ")} UTC`;
};
const sourceState = { ok: "Reachable", blocked: "Blocked", error: "Fetch failed", pending: "Not yet collected" } as const;
const backfillState = { pending: "Pending", partial: "Partial", complete: "Complete", blocked: "Blocked" } as const;
---

<Layout title="Source discovery" active="updates" description="Filter the automated discovery snapshot by source, priority, review state, topic and system. Source failures and incomplete backfills remain visible.">
  <div class="page-container discovery-page">
    <header class="page-header">
      <p class="muted">Automated discovery · snapshot <time datetime={discovery.syncedAt}>{dateLabel(discovery.syncedAt)}</time></p>
      <h1>Source discovery</h1>
      <p>External publications are leads, not reviewed Observatory findings. Titles and summaries are publisher metadata; open the original source to inspect it. A blocked source may retain older items without having been checked successfully again.</p>
      <p><a href={withBase("/updates")}>Reviewed updates and pending changes →</a> · <a href={withBase("/api/v2/discovery.json")}>Discovery JSON</a> · <a href={withBase("/digest.xml")}>Weekly digest RSS</a></p>
    </header>

    <section aria-labelledby="items-title">
      <h2 id="items-title">Discovered publications <span class="muted">({items.length})</span></h2>
      <form id="feed-filters" class="filter-grid panel" action={withBase("/feed")} method="get" aria-label="Filter discovery items">
        <label class="field">Source
          <select name="source"><option value="">All sources</option>{sourceOptions.map((source) => <option value={source.id}>{source.name}</option>)}</select>
        </label>
        <label class="field">Priority
          <select name="priority"><option value="">All priorities</option>{["correction", "fix", "drift", "research", "background"].map((priority) => <option value={priority}>{priority}</option>)}</select>
        </label>
        <label class="field">Review
          <select name="review"><option value="">All states</option><option value="unreviewed">Unreviewed</option><option value="linked">Linked</option><option value="dismissed">Dismissed</option></select>
        </label>
        <label class="field">Topic
          <select name="topic"><option value="">All topics</option>{topics.map((topic) => <option value={topic}>{topic}</option>)}</select>
        </label>
        <label class="field">System
          <select name="system"><option value="">All systems</option>{systems.map((system) => <option value={system}>{system}</option>)}</select>
        </label>
        <div class="filter-actions"><button class="button" type="submit">Apply filters</button><a href={withBase("/feed")}>Clear</a></div>
      </form>
      <p id="feed-result-count" class="muted" aria-live="polite">{items.length} items in the committed snapshot.</p>
      <div class="table-wrap">
        <table class="data-table feed-table">
          <caption>Publisher discovery metadata, sorted by publication date where supplied, otherwise by first-seen date. Review state does not imply a validated claim.</caption>
          <thead><tr><th scope="col">Publication</th><th scope="col">Source and scope</th><th scope="col">Date</th><th scope="col">Review</th></tr></thead>
          <tbody>
            {items.map((item) => {
              const href = safeExternal(item.url);
              const source = sources.get(item.sourceId);
              return <tr data-feed-item id={`item-${item.id}`} data-source={item.sourceId} data-priority={item.priority} data-review={item.review} data-topics={JSON.stringify(item.topics)} data-systems={JSON.stringify(item.systemIds)}>
                <th scope="row">
                  {href ? <a href={href} target="_blank" rel="noopener noreferrer">{item.title}</a> : <span>{item.title}</span>}
                  {item.summary && <p class="item-summary">{item.summary}</p>}
                  {item.recordIds.length > 0 && <p class="item-links">Records: {item.recordIds.map((id, index) => <><a href={withBase(`/records/${id}`)}>{id}</a>{index < item.recordIds.length - 1 ? ", " : ""}</>)}</p>}
                  {item.claimIds.length > 0 && <p class="item-links">Claims: {item.claimIds.map((id, index) => <><a href={withBase(`/claims/${id}`)}>{id}</a>{index < item.claimIds.length - 1 ? ", " : ""}</>)}</p>}
                </th>
                <td>{source?.name ?? item.sourceId}<br /><span class="muted">{item.topics.join(", ") || "No topic assigned"} · {item.systemIds.join(", ") || "No system assigned"}</span>{source && source.state !== "ok" && <><br /><span class="badge">Source {sourceState[source.state].toLowerCase()}</span></>}</td>
                <td>{item.published ? <>Published <time datetime={item.published}>{dateLabel(item.published)}</time></> : <>Publication date unknown</>}<br /><span class="muted">First seen <time datetime={item.firstSeen}>{dateLabel(item.firstSeen)}</time></span></td>
                <td><span class="badge">{item.review}</span><br /><span class="muted">{item.priority}</span></td>
              </tr>;
            })}
          </tbody>
        </table>
      </div>
      {items.length === 0 && <p>No publications were recorded in this snapshot. See source status below for collection failures.</p>}
      <p id="feed-no-results" hidden>No items match these filters. <a href={withBase("/feed")}>Clear filters</a> to see the complete snapshot.</p>
    </section>

    <section aria-labelledby="sources-title">
      <h2 id="sources-title">Collection status <span class="muted">({discoverySources.length} sources)</span></h2>
      <p>Last attempt and last successful retrieval are distinct. Backfill is historical coverage, not proof that older material was exhaustively indexed. Status is as of the committed snapshot, not a live check.</p>
      <div class="table-wrap"><table class="data-table status-table">
        <caption>All configured discovery sources, including blocked and failed sources, with last success and historical backfill scope.</caption>
        <thead><tr><th scope="col">Source</th><th scope="col">Status / last attempt</th><th scope="col">Last success</th><th scope="col">Backfill scope</th></tr></thead>
        <tbody>{sourceOptions.map((source) => <tr>
          <th scope="row">{safeExternal(source.url) ? <a href={safeExternal(source.url)!} target="_blank" rel="noopener noreferrer">{source.name}</a> : source.name}<br /><span class="muted">{source.itemCount} retained items</span></th>
          <td><span class="badge">{sourceState[source.state]}</span>{source.httpStatus !== null && <> · HTTP {source.httpStatus}</>}<br /><span class="muted">Attempted <time datetime={source.lastAttempt}>{dateLabel(source.lastAttempt)}</time></span>{source.error && <p class="status-detail">{source.error}</p>}</td>
          <td>{source.lastSuccess ? <time datetime={source.lastSuccess}>{dateLabel(source.lastSuccess)}</time> : "Never recorded"}</td>
          <td>{backfillState[source.backfill.state]}{(source.backfill.inspectedFrom || source.backfill.inspectedThrough) && <><br /><span class="muted">Inspected {source.backfill.inspectedFrom ?? "unknown start"} – {source.backfill.inspectedThrough ?? "unknown end"}</span></>}<p class="status-detail">{source.backfill.detail}</p></td>
        </tr>)}</tbody>
      </table></div>
    </section>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#feed-filters");
  if (form) {
    const params = new URLSearchParams(window.location.search);
    const fields = ["source", "priority", "review", "topic", "system"] as const;
    for (const key of fields) {
      const select = form.elements.namedItem(key);
      if (select instanceof HTMLSelectElement) {
        const value = params.get(key);
        if (value && [...select.options].some((option) => option.value === value)) select.value = value;
      }
    }
    const matches = (row: HTMLTableRowElement) => fields.every((key) => {
      const value = params.get(key);
      if (!value) return true;
      if (key === "topic" || key === "system") {
        const list = JSON.parse(row.dataset[key === "topic" ? "topics" : "systems"] ?? "[]") as string[];
        return list.includes(value);
      }
      return row.dataset[key] === value;
    });
    const rows = document.querySelectorAll<HTMLTableRowElement>("[data-feed-item]");
    let count = 0;
    for (const row of rows) {
      row.hidden = !matches(row);
      if (!row.hidden) count++;
    }
    const result = document.querySelector<HTMLElement>("#feed-result-count");
    if (result) result.textContent = `${count} of ${rows.length} items shown from the committed snapshot.`;
    const noResults = document.querySelector<HTMLElement>("#feed-no-results");
    if (noResults) noResults.hidden = count !== 0 || rows.length === 0;
  }
</script>

<style>
  .discovery-page { padding-block: 2rem 5rem; }
  .page-header { max-width: 75ch; margin-bottom: 2rem; }
  .page-header h1 { margin-block: .3rem .8rem; }
  .page-header a, .discovery-page td a, .discovery-page th a, #feed-no-results a { color: var(--accent); text-decoration: underline; text-underline-offset: .18em; }
  .discovery-page section { margin-block: 2rem 3rem; }
  .discovery-page h2 { margin-bottom: .5rem; }
  .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .75rem; align-items: end; padding: 1rem; }
  .field { display: grid; gap: .25rem; }
  .field select { width: 100%; min-height: 2.6rem; padding: .4rem; color: var(--text); background: var(--panel); border: 1px solid var(--border); }
  .filter-actions { display: flex; flex-wrap: wrap; gap: .7rem; align-items: center; }
  .filter-actions a { color: var(--accent); }
  .table-wrap { overflow-x: auto; }
  .feed-table { min-width: 720px; }
  .status-table { min-width: 680px; }
  .data-table { width: 100%; border-collapse: collapse; }
  .data-table caption { text-align: left; color: var(--muted); margin-bottom: .65rem; }
  .data-table th, .data-table td { text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); padding: .75rem; }
  .data-table thead th { white-space: nowrap; }
  .feed-table th:first-child { width: 39%; }
  .feed-table td { overflow-wrap: anywhere; }
  .feed-table th:first-child { overflow-wrap: anywhere; }
  .item-summary { font-weight: 400; color: var(--muted); margin: .35rem 0; }
  .item-links, .status-detail { font-weight: 400; margin: .25rem 0 0; }
  .status-detail { overflow-wrap: anywhere; }
  .muted { color: var(--muted); }
  .badge { display: inline-block; font-size: .82rem; }
  @media (max-width: 640px) { .discovery-page { padding-block: 1rem 3rem; } .data-table th, .data-table td { padding: .5rem; } }
</style>
